{
  "id": "orca-web",
  "version": "1.2.0",
  "name": "Orca Web",
  "description": "Orca Web with persistent profile, lifecycle and loopback pairing gateway (Ubuntu 26.04).",
  "options": {
    "version": {
      "type": "string",
      "default": "v1.4.253",
      "description": "Orca release tag"
    }
  },
  "mounts": [
    {
      "source": "orca-web",
      "target": "/var/lib/orca-web",
      "type": "volume"
    }
  ],
  "postStartCommand": "/usr/local/bin/orca-web start",
  "entrypoint": "/usr/local/lib/orca-web/orca-web-init.sh"
}
